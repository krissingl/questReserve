{
  "name": "questreserve-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "knex": "knex --knexfile knexfile.ts --esm",
    "migrate": "npm run knex migrate:latest",
    "test": "jest --testPathPatterns=\"\\.test\\.ts$\" --testPathIgnorePatterns=\"\\.integration\\.test\\.ts$\"",
    "test:integration": "jest --testPathPatterns=\"\\.integration\\.test\\.ts$\" --runInBand",
    "test:all": "jest --runInBand"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!uuid)"
    ],
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/src/tests/__mocks__/uuid.js"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.8",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "jest": "^30.3.0",
    "pg": "^8.17.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
