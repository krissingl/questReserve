# QuestReserve Backend — environment variables
# Copy this file to .env and fill in values for local development.
# The .env file is gitignored and must never be committed.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=questreserve
DB_USER=postgres
DB_PASSWORD=

# JWT secret for authentication
JWT_SECRET=

# Backend public URL (used for building image URLs returned to clients)
BACKEND_PUBLIC_URL=http://localhost:3001

# GitHub integration (optional — only required for GitHub issue features)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
